# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# package-lock.json generado en Windows queda repetidamente inconsistente
# para el árbol opcional/WASM de @napi-rs/@emnapi/unrs-resolver (npm no
# escribe ahí la variante que algunos paquetes necesitan en otra
# plataforma) — EAS Build corre "npm ci" cuando hay lockfile y eso no
# tiene tolerancia a esa inconsistencia (falla con EUSAGE), mientras que
# "npm install" sí la resuelve sola. No versionarlo hace que EAS use
# npm install. Mismo problema y mismo criterio que en
# BoxService_FrontEnd/.github/workflows/ci.yml.
package-lock.json

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files (.env.example sí se versiona, no tiene secretos reales)
.env
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android
